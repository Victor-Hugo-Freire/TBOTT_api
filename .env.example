# Variáveis da TBOTT API (somente servidor). Copie para .env e preencha.
# O .env nunca deve ser commitado nem usado no front-end.

PORT=8000
# Em "production", os cookies de sessão passam a exigir HTTPS (Secure).
NODE_ENV=development

# Endereços do TBOTT_web que podem usar a API pelo navegador com cookies (CORS e CSRF),
# separados por vírgula. Use o endereço exato, sem barra no final. Sem esta variável,
# o padrão em desenvolvimento é http://localhost:5173; em produção, nenhum.
FRONTEND_ORIGINS=http://localhost:5173
# SameSite dos cookies de sessão: lax (padrão), strict ou none. Use "none" só se, em produção,
# o front-end e a API ficarem em sites diferentes (exige NODE_ENV=production). Veja o README.
# SESSION_COOKIE_SAMESITE=lax

# Projeto Supabase - Connect > Transaction pooler
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres

SUPABASE_URL=https://your-project-ref.supabase.co
# Chave pública do projeto (sb_publishable_...), usada para o cliente Supabase Auth.
SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade com configurações antigas do projeto.
# SUPABASE_ANON_KEY=
# O link do e-mail de confirmação leva à "Site URL" do painel do Supabase (veja o README).

# Opcionais
# Certificado CA do Supabase para validar o SSL (Database > Settings > SSL Configuration).
# DATABASE_SSL_CA_PATH=
# Somente para "npm run db:test-users". Chave secreta (sb_secret_...): nunca no front-end.
# SUPABASE_SECRET_KEY=
# TEST_USERS_PASSWORD=
